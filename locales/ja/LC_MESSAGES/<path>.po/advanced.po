#: ../../scientific-python-lectures/advanced/debugging/index.rst:498
msgid "``l(list)``"
msgstr "``l(list)``"

#: ../../scientific-python-lectures/advanced/debugging/index.rst:498
msgid "Lists the code at the current position"
msgstr "現在位置のコードを一覧表示"

#: ../../scientific-python-lectures/advanced/debugging/index.rst:499
msgid "``u(p)``"
msgstr "``u(p)``"

#: ../../scientific-python-lectures/advanced/debugging/index.rst:499
