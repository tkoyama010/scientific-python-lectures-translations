msgstr "コールスタックを上へ"

#: ../../scientific-python-lectures/advanced/debugging/index.rst:500
msgid "``d(own)``"
msgstr "``d(own)``"

#: ../../scientific-python-lectures/advanced/debugging/index.rst:500
msgid "Walk down the call stack"
msgstr "コールスタックを下へ"

#: ../../scientific-python-lectures/advanced/debugging/index.rst:501
msgid "``n(ext)``"
msgstr "``n(ext)``"

#: ../../scientific-python-lectures/advanced/debugging/index.rst:501
